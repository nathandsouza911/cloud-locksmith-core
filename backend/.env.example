# Cloud Locksmith Core: backend settings for a real tenant (see docs/connect-a-real-tenant.md).
# Copy to backend/.env and fill in. Every value below is a placeholder.
# The demo (docker compose at the repo root) needs none of this.

ENVIRONMENT=development
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Matches backend/docker-compose.yml (Postgres on localhost:5432).
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cloudlocksmith

# Your Entra app registration (multi-tenant). Redirect URI must match exactly.
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=replace-with-your-client-secret
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me
APP_JWT_SECRET=replace-me
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-me

# Background jobs. Both are off by default. Enable the scheduler only after you have
# reviewed what it runs; leave auto-remediation off.
ENABLE_SCHEDULER=false
ENABLE_AUTO_REMEDIATION=false

# Outgoing email (optional): sender domain and Resend API key.
EMAIL_FROM_DOMAIN=example.com
# RESEND_API_KEY=
